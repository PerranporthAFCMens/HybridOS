{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "_site",
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/hybrid-hub",
      "destination": "/hybrid-hub-login.html"
    },
    {
      "source": "/puffin-performance",
      "destination": "/puffin-performance-login.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/join/:slug",
      "destination": "/next/index.html"
    },
    {
      "source": "/:screen(today|members|plans|classes|reports|staff|rooms|access|owners|door|member-view|community|communications|workouts|membership-rules|membership-requests|signup-process|settings|class-setup)",
      "destination": "/next/index.html"
    },
    {
      "source": "/m/:path*",
      "destination": "/next/index.html"
    }
  ]
}
