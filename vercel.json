{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "_site",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/login",
      "destination": "/sign-in",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/sign-in",
      "permanent": false
    },
    {
      "source": "/choose-gym.html",
      "destination": "/choose-gym",
      "permanent": false
    },
    {
      "source": "/auth-return.html",
      "destination": "/auth-return",
      "permanent": false
    },
    {
      "source": "/admin-invite.html",
      "destination": "/invite",
      "permanent": false
    },
    {
      "source": "/sign-out.html",
      "destination": "/sign-out",
      "permanent": false
    },
    {
      "source": "/hybrid-hub",
      "destination": "/sign-in?gym_id=242f57c2-6e37-4977-b3c5-1c87de7d0b98",
      "permanent": false
    },
    {
      "source": "/hybrid-hub-login.html",
      "destination": "/sign-in?gym_id=242f57c2-6e37-4977-b3c5-1c87de7d0b98",
      "permanent": false
    },
    {
      "source": "/puffin-performance",
      "destination": "/sign-in?gym_id=aec16956-3793-4543-873b-4412646ca1eb",
      "permanent": false
    },
    {
      "source": "/puffin-performance-login.html",
      "destination": "/sign-in?gym_id=aec16956-3793-4543-873b-4412646ca1eb",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "access_invite"
        }
      ],
      "destination": "/invite",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/join/:slug",
      "destination": "/next/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/data-deletion",
      "destination": "/data-deletion.html"
    },
    {
      "source": "/:screen(today|members|plans|classes|reports|staff|rooms|access|owners|door|member-view|community|communications|workouts|training|membership-rules|membership-requests|signup-process|member-privacy|settings|class-setup|programmes|movements|estate|lifts|payments|sign-in|choose-gym|auth-return|auth-confirm|sign-out|invite)",
      "destination": "/next/index.html"
    },
    {
      "source": "/members/:userId",
      "destination": "/next/index.html"
    },
    {
      "source": "/s/:path*",
      "destination": "/next/index.html"
    },
    {
      "source": "/m/:path*",
      "destination": "/next/index.html"
    }
  ]
}
