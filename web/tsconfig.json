{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "npm:pdf-lib@1.17.1": ["./node_modules/pdf-lib"], "jsr:@supabase/supabase-js@2.116.0": ["./node_modules/@supabase/supabase-js"] }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
